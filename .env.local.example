# ===== قاعدة البيانات (Neon) =====
# من https://console.neon.tech → مشروعك → Connection Details
DATABASE_URL=

# ===== Auth.js v5 =====
# ولّد سراً عشوائياً: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ===== Google OAuth =====
# من https://console.cloud.google.com → APIs & Services → Credentials
# URI إعادة التوجيه المطلوب: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ===== الروابط العامة =====
# يُستخدم في روابط المشاركة/التحقق وواتساب (بدون شرطة مائلة في النهاية)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ===== تيليجرام (اختياري — إشعارات الفتح والتوقيع) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== لوحة الإدارة =====
ADMIN_EMAILS=

# ===== مهام Cron اليومية (Vercel Cron — إلزامي في الإنتاج) =====
# ولّد سراً عشوائياً: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ===== قائمة النطاقات المسموحة (اختياري إضافي فوق NEXT_PUBLIC_BASE_URL) =====
ALLOWED_HOSTS=miithaq.com,www.miithaq.com

# ===== بيانات الدفع والدعم (أضف حساباتك قبل تفعيل الاشتراكات) =====
NEXT_PUBLIC_SHAM_CASH_ACCOUNT=
NEXT_PUBLIC_SHAM_CASH_NAME=
NEXT_PUBLIC_USDT_TRC20_ADDRESS=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

