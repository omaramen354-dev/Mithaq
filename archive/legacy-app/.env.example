# ===== الخادم =====
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5000

# ===== الأمان (إلزامي في الإنتاج!) =====
# مفتاح تشفير العقود — 24 حرفاً على الأقل. ولّد واحداً قوياً ولا تشاركه.
# مثال توليد: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-to-a-long-random-secret-key-32ch

# ===== Google OAuth (GIS) =====
# من https://console.cloud.google.com → APIs & Services → Credentials
# يُقرأ آلياً من الخادم عبر /api/auth/config لعرض زر "Sign in with Google"
GOOGLE_CLIENT_ID=
# الرابط العام للمنصة (يُستخدم في روابط QR والتحقق وواتساب وإشعارات تيليجرام)
BASE_URL=http://localhost:5000

# ===== لوحة الإدارة =====
# قائمة إيميلات المشرفين مفصولة بفواصل — من يدخل بإيميل منها يرى زر "لوحة الإدارة"
# إن تُركت فارغة في التطوير يُعتبر أول مستخدم مشرفاً؛ في الإنتاج يجب تعبئتها
ADMIN_EMAILS=

# ===== الدفع =====
# محفظة USDT (TRC20) لاستلام المدفوعات
USDT_TRC20_ADDRESS=
# رابط دفع شام كاش (اختياري — إن وُجد)
SHAM_CASH_CHECKOUT_URL=

# ===== بوابة Cryptomus (عند التفعيل) =====
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=

# ===== Telegram (اختياري — تقارير مجلس ميثاق) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== تطوير فقط =====
# يسمح بزر "تأكيد تجريبي" للدفع — لا تفعّله في الإنتاج!
ALLOW_DEMO_CONFIRM=false
